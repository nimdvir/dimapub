---
import Base from '../layouts/Base.astro';
import LoopMedia from '../components/LoopMedia.astro';
import Icon from '../components/Icon.astro';
import { img, srcset, media } from '../lib/media';

const photos = [
  { id: media.dimaSunset, alt: 'Dima grinning at the camera at sunset', caption: 'Golden hour', tilt: -4 },
  { id: media.dimaPillow, alt: 'Dima resting a chin on a soft pillow, looking up', caption: 'Reading break', tilt: 3 },
  { id: media.dimaSweater, alt: 'Dima in a red sweater', caption: 'Dressed for winter', tilt: -2 },
];
---

<Base title="For Dima" description="A small corner of the website for the dog this company is named after." headerTone="night">
  <section class="dima-hero on-night">
    <div class="stars" aria-hidden="true"></div>
    <div class="container split">
      <div>
        <p class="eyebrow reveal">A dedication</p>
        <h1 class="reveal" style="--d:.06s">For <em class="gold">Dima</em>.</h1>
        <p class="lede reveal" style="--d:.12s">
          Every company has a story about its name. Ours has four paws, very expressive ears and a smile you can see
          from across the beach.
        </p>
      </div>
      <figure class="portrait reveal" style="--d:.1s">
        <div class="frame">
          <LoopMedia id={media.loop} kind="video" width={560} label="Dima looking up at the sky at sunset, then smiling at the camera" eager />
        </div>
        <figcaption><Icon name="paw" size={16} /> Dima, at sunset</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow letter reveal">
      <p class="dropcap">
        Dima is the reason this press has a name, and the reason it has a heart. Curious about everything, patient with
        everyone, always certain that today might hold something wonderful: that is a good way to approach a dog’s
        day, and a pretty good way to approach learning, too.
      </p>
      <p>
        So every book we publish carries Dima’s name on the spine. It is a small promise to our readers: we will be
        curious alongside you, we will be patient when something is hard, and we will always be glad you showed up.
      </p>
      <div class="divider-diamond" aria-hidden="true">
        <Icon name="heart" size={18} />
      </div>
    </div>
  </section>

  <section class="section tight on-paper-2">
    <div class="container">
      <div class="gallery">
        {
          photos.map((p, i) => (
            <figure class="polaroid reveal" style={`--t:${p.tilt}deg; --d:${i * 0.1}s`}>
              <img
                src={img(p.id, 600, 'c_fill,g_auto,h_600,w_600')}
                srcset={srcset(p.id, [320, 480, 600], 'c_fill,g_auto,h_600,w_600')}
                sizes="(max-width: 760px) 80vw, 340px"
                width="600"
                height="600"
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="plate reveal">
        <LoopMedia id={media.reading} width={560} label="Line drawing of Dima reading an open book, the Dima Publishing mark" />
      </div>
      <div class="reveal" style="--d:.08s">
        <p class="eyebrow">The mark</p>
        <h2>Always reading.</h2>
        <p class="lede">
          Our logo is Dima with an open book: ears up, eyes bright, fully invested in the next page. It is the reader
          we hope every student gets to be.
        </p>
        <a class="btn ghost" href="/books/">See what Dima is reading <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dima-hero {
    position: relative;
    overflow: hidden;
    margin-top: calc(var(--header-h) * -1);
    padding: calc(var(--header-h) + clamp(40px, 7vw, 100px)) 0 clamp(56px, 9vw, 120px);
  }
  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 12% 22%, rgba(255, 240, 200, 0.7), transparent),
      radial-gradient(1px 1px at 32% 68%, rgba(255, 240, 200, 0.6), transparent),
      radial-gradient(1.5px 1.5px at 58% 14%, rgba(255, 240, 200, 0.8), transparent),
      radial-gradient(1px 1px at 76% 42%, rgba(255, 240, 200, 0.5), transparent),
      radial-gradient(1.5px 1.5px at 88% 80%, rgba(255, 240, 200, 0.7), transparent),
      radial-gradient(1px 1px at 22% 88%, rgba(255, 240, 200, 0.5), transparent),
      radial-gradient(1px 1px at 46% 40%, rgba(255, 240, 200, 0.4), transparent);
    animation: twinkle 6s ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    to {
      opacity: 0.45;
    }
  }
  .dima-hero h1 {
    font-size: clamp(3.2rem, 9vw, 7rem);
  }
  .portrait {
    margin: 0;
    position: relative;
  }
  .frame {
    max-width: 440px;
    margin-inline: auto;
    border-radius: 50% 50% 28px 28px / 40% 40% 28px 28px;
    overflow: hidden;
    border: 1px solid rgba(220, 182, 94, 0.5);
    box-shadow:
      0 0 0 10px rgba(220, 182, 94, 0.08),
      0 40px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .frame :global(video) {
    aspect-ratio: 1;
    object-fit: cover;
  }
  .portrait figcaption {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }
  .letter p {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.55;
    color: var(--ink-2);
    font-variation-settings: 'opsz' 24, 'SOFT' 100;
  }
  .dropcap::first-letter {
    float: left;
    font-size: 3.6em;
    line-height: 0.82;
    padding: 0.06em 0.1em 0 0;
    color: var(--gold-deep);
  }
  .divider-diamond {
    margin-top: 40px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 44px);
    max-width: 1080px;
    margin-inline: auto;
  }
  .polaroid {
    margin: 0;
    padding: 14px 14px 18px;
    background: #fff;
    box-shadow: var(--shadow);
    rotate: var(--t);
    transition:
      rotate 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  .polaroid:hover {
    rotate: 0deg;
    transform: translateY(-6px) scale(1.02);
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .polaroid figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    text-align: center;
    margin-top: 12px;
    color: var(--ink-soft);
  }
  .plate {
    max-width: 420px;
  }
  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
</style>
