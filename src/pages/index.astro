---
import Galaxy from '../components/Galaxy.astro';
import Base from '../layouts/Base.astro';
import LoopMedia from '../components/LoopMedia.astro';
import Icon from '../components/Icon.astro';
import Diamond from '../components/Diamond.astro';
import { site } from '../data/site';
import { media } from '../lib/media';

const marquee = [
  'Books',
  'Interactive textbooks',
  'Interactive reading',
  'Hands-on labs',
  'Reading assessments',
  'Instructor resources',
  'Digital learning experiences',
  'Real business questions',
];

const doors = [
  { host: 'dimapub.com', label: 'Publishing', body: 'Our home: titles, news and how we work.', href: '/', here: true },
  { host: 'dimapub.com/books', label: 'Books', body: 'The full catalog of Dima titles.', href: '/books/' },
  { host: 'Interactive reader', label: 'Read', body: 'Our interactive textbook reader.', href: site.readerUrl, external: true },
  { host: 'dimapub.com/learn', label: 'Learning platform', body: 'How our books teach, and what comes next.', href: '/learn/' },
  { host: 'dimapub.com/resources', label: 'Resources', body: 'For instructors, students and programs.', href: '/resources/' },
];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero grain">
    <div class="halo" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">Independent educational publisher</p>
        <h1 class="reveal" style="--d:.08s">
          Publishing for the way we <em class="gold">learn</em> today.
        </h1>
        <p class="lede reveal" style="--d:.16s">
          Books, interactive textbooks, and digital learning experiences that connect what students read to what
          they will actually do.
        </p>
        <div class="cta-row reveal" style="--d:.24s">
          <a class="btn" href="/books/">
            Explore our books <Icon name="arrow" size={18} />
          </a>
          <a class="btn ghost" href="/about/">About us</a>
        </div>
      </div>

      <div class="hero-art reveal" style="--d:.12s">
        <div class="plate">
          <LoopMedia id={media.diamond} width={640} label="Animated Dima Publishing logo: Dima the dog above an open book and a gold diamond" blend eager />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [...marquee, ...marquee].map((w) => (
          <span>
            {w}
            <Diamond size={14} />
          </span>
        ))
      }
    </div>
  </div>

  <!-- ============ WHAT WE MAKE ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What we make</p>
        <h2>Learning materials that respect your time <em class="gold">and</em> your intelligence.</h2>
      </div>
      <div class="grid cols-3 make">
        <article class="card reveal">
          <span class="ico"><Icon name="book" size={26} /></span>
          <h3>Books</h3>
          <p>Clear, carefully edited titles written by people who teach the subject, and tested with the students who learn it.</p>
          <a class="text-link" href="/books/">See the catalog</a>
        </article>
        <article class="card reveal" style="--d:.08s">
          <span class="ico"><Icon name="screen" size={26} /></span>
          <h3>Interactive textbooks</h3>
          <p>Reading, practice and feedback in one place. Run the code, check your understanding, and see the idea work.</p>
          <a class="text-link" href={site.readerUrl} target="_blank" rel="noopener">Try the reader</a>
        </article>
        <article class="card reveal" style="--d:.16s">
          <span class="ico"><Icon name="graduation" size={26} /></span>
          <h3>Digital learning experiences</h3>
          <p>Labs, projects and assessments that ask students to build and explain real work, not just pick an answer.</p>
          <a class="text-link" href="/learn/">How our books teach</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ DOORS ============ -->
  <section class="section tight doors-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">One house, several doors</p>
        <h2>Everything Dima, in one place.</h2>
      </div>
      <div class="doors">
        {
          doors.map((d, i) => (
            <a
              class:list={['door', 'reveal', { here: d.here }]}
              style={`--d:${i * 0.06}s`}
              href={d.href}
              target={d.external ? '_blank' : undefined}
              rel={d.external ? 'noopener' : undefined}
            >
              <span class="host">{d.host}</span>
              <span class="label">{d.label}</span>
              <span class="body">{d.body}</span>
              <span class="go">
                {d.here ? 'You are here' : d.external ? 'Open' : 'Visit'}
                {!d.here && <Icon name={d.external ? 'external' : 'arrow'} size={15} />}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DIMA ============ -->
  <section class="section dima-teaser on-paper-2">
    <div class="container split">
      <div class="reading plate reveal">
        <LoopMedia id={media.reading} width={560} label="Line drawing of Dima the dog reading an open book" blend />
      </div>
      <div class="reveal" style="--d:.1s">
        <p class="eyebrow">Why “Dima”?</p>
        <h2>Named for a very good dog.</h2>
        <p class="lede">
          Every book we publish carries Dima’s name, and the standard that comes with it: be curious, be patient, be
          glad to see whoever walks through the door. Good teaching works the same way.
        </p>
        <a class="btn ghost" href="/dima/">Visit Dima’s corner <Icon name="heart" size={16} /></a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 110px);
  }
  .halo {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 980px;
    max-height: 980px;
    background: radial-gradient(closest-side, rgba(220, 182, 94, 0.28), rgba(220, 182, 94, 0.08) 55%, transparent 72%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero h1 {
    margin-bottom: 0.35em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero-art {
    position: relative;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* ---------- marquee ---------- */
  .marquee {
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding: 18px 0;
    background: var(--card);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    gap: 40px;
    width: max-content;
    animation: scroll 46s linear infinite;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- make ---------- */
  .make .card {
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .make .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .ico {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--gold-wash);
    color: var(--gold-deep);
    margin-bottom: 22px;
  }
  .make p {
    color: var(--ink-soft);
  }

  /* ---------- doors ---------- */
  .doors {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 22px;
    min-height: 220px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.3s;
  }
  .door:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: var(--gold);
  }
  .door.here {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .host {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold-deep);
    word-break: break-all;
  }
  .here .host {
    color: var(--gold-bright);
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .body {
    font-size: 0.9rem;
    color: var(--muted);
    flex: 1;
  }
  .here .body {
    color: rgba(251, 249, 244, 0.7);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
  }
  @media (max-width: 1080px) {
    .doors {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .door {
      min-height: 0;
    }
  }

  /* ---------- dima ---------- */
  .reading {
    max-width: 400px;
  }

</style>
