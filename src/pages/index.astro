---
import Galaxy from '../components/Galaxy.astro';
import Base from '../layouts/Base.astro';
import LoopMedia from '../components/LoopMedia.astro';
import BookCover from '../components/BookCover.astro';
import Icon from '../components/Icon.astro';
import Diamond from '../components/Diamond.astro';
import { site, book } from '../data/site';
import { differences, arc, rhythm } from '../data/book';
import { media } from '../lib/media';

const marquee = [
  'Books',
  'Interactive textbooks',
  'Executable SQL',
  'Hands-on labs',
  'Reading assessments',
  'Instructor resources',
  'Digital learning experiences',
  'Real business questions',
];

const doors = [
  { host: 'dimapub.com', label: 'Publishing', body: 'Our home: titles, news and how we work.', href: '/', here: true },
  { host: 'dimapub.com/books', label: 'Books', body: 'The catalog, starting with our first title.', href: '/books/' },
  { host: 'Interactive reader', label: 'Read', body: 'The full textbook, with SQL you can run.', href: site.readerUrl, external: true },
  { host: 'dimapub.com/learn', label: 'Learning platform', body: 'How our books teach, and what comes next.', href: '/learn/' },
  { host: 'dimapub.com/resources', label: 'Resources', body: 'For instructors, students and programs.', href: '/resources/' },
];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero grain">
    <div class="halo" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">Independent educational publisher</p>
        <h1 class="reveal" style="--d:.08s">
          Publishing for the way we <em class="gold">learn</em> today.
        </h1>
        <p class="lede reveal" style="--d:.16s">
          Books, interactive textbooks, and digital learning experiences that connect what students read to what
          they will actually do.
        </p>
        <div class="cta-row reveal" style="--d:.24s">
          <a class="btn" href={`/books/${book.slug}/`}>
            Explore our first title <Icon name="arrow" size={18} />
          </a>
          <a class="btn ghost" href={site.readerUrl} target="_blank" rel="noopener">
            Open the reader <Icon name="external" size={16} />
          </a>
        </div>
        <ul class="facts reveal" style="--d:.32s">
          <li><strong>16</strong> chapters</li>
          <li><strong>Live</strong> SQL in the browser</li>
          <li><strong>2</strong> running projects</li>
        </ul>
      </div>

      <div class="hero-art reveal" style="--d:.12s">
        <div class="plate">
          <LoopMedia id={media.diamond} width={640} label="Animated Dima Publishing logo: Dima the dog above an open book and a gold diamond" blend eager />
        </div>
        <span class="chip c1"><Icon name="book" size={16} /> Books</span>
        <span class="chip c2"><Icon name="screen" size={16} /> Interactive textbooks</span>
        <span class="chip c3"><Icon name="spark" size={16} /> Digital learning</span>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [...marquee, ...marquee].map((w) => (
          <span>
            {w}
            <Diamond size={14} />
          </span>
        ))
      }
    </div>
  </div>

  <!-- ============ WHAT WE MAKE ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What we make</p>
        <h2>Learning materials that respect your time <em class="gold">and</em> your intelligence.</h2>
      </div>
      <div class="grid cols-3 make">
        <article class="card reveal">
          <span class="ico"><Icon name="book" size={26} /></span>
          <h3>Books</h3>
          <p>Clear, carefully edited titles written by people who teach the subject, and tested with the students who learn it.</p>
          <a class="text-link" href="/books/">See the catalog</a>
        </article>
        <article class="card reveal" style="--d:.08s">
          <span class="ico"><Icon name="screen" size={26} /></span>
          <h3>Interactive textbooks</h3>
          <p>Reading, practice and feedback in one place. Run the code, check your understanding, and see the idea work.</p>
          <a class="text-link" href={site.readerUrl} target="_blank" rel="noopener">Try the reader</a>
        </article>
        <article class="card reveal" style="--d:.16s">
          <span class="ico"><Icon name="graduation" size={26} /></span>
          <h3>Digital learning experiences</h3>
          <p>Labs, projects and assessments that ask students to build and explain real work, not just pick an answer.</p>
          <a class="text-link" href="/learn/">How our books teach</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED BOOK ============ -->
  <section class="section on-night featured" id="book">
    <Galaxy />
    <div class="container split">
      <div class="cover-col reveal">
        <div class="glow" aria-hidden="true"></div>
        <BookCover width={380} />
      </div>
      <div class="reveal" style="--d:.1s">
        <p class="eyebrow">Our first title · Now in the classroom</p>
        <h2>{book.title}</h2>
        <p class="sub"><span>{book.subtitle}</span><span class="by">by {book.author}</span></p>
        <p class="lede">
          The hard part of a database course isn’t the syntax. It’s knowing which question is worth asking, and
          trusting the answer enough to act on it. This book is written for students who will run teams, budgets and
          companies, and it teaches data the way they’ll use it: starting with a real decision, and ending with a
          recommendation they can defend.
        </p>
        <div class="cta-row">
          <a class="btn gold" href={site.readerUrl} target="_blank" rel="noopener">
            Start reading <Icon name="external" size={16} />
          </a>
          <a class="btn ghost" href={`/books/${book.slug}/`}>Why it’s different <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DIFFERENCES ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why this book is different</p>
        <h2>A database course that finally feels like <em class="gold">business</em>.</h2>
        <p class="lede">
          Students tell us the same things: “I know the terms but not how they connect.” “We learn SQL, but I
          don’t know why it matters.” So we built the book around those two sentences.
        </p>
      </div>
      <div class="grid cols-3 diffs">
        {
          differences.map((d, i) => (
            <article class="diff reveal" style={`--d:${(i % 3) * 0.08}s`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={d.icon} size={26} class="diff-ico" />
              <h3>{d.title}</h3>
              <p>{d.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LEARNING ARC ============ -->
  <section class="section tight on-paper-2 arc-section">
    <div class="container">
      <div class="section-head center reveal">
        <p class="eyebrow">The learning arc</p>
        <h2>From a single number to a confident decision.</h2>
      </div>
      <ol class="arc reveal">
        {
          arc.map((step, i) => (
            <li style={`--i:${i}`}>
              <span class="dot" aria-hidden="true" />
              <span class="step">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ RHYTHM ============ -->
  <section class="section">
    <div class="container split rhythm-split">
      <div class="reveal">
        <p class="eyebrow">Inside every chapter</p>
        <h2>The same steady rhythm, so you always know where you are.</h2>
        <p class="lede">
          Every chapter moves through six parts, from the big idea to work you can show someone. Instructors get a
          predictable structure that maps cleanly onto any LMS; students get a path that never leaves them
          guessing.
        </p>
        <a class="text-link" href={`/books/${book.slug}/#contents`}>See the full table of contents →</a>
      </div>
      <ol class="rhythm">
        {
          rhythm.map((r, i) => (
            <li class="reveal" style={`--d:${i * 0.06}s`}>
              <span class="n">{r.n}</span>
              <div>
                <h4>{r.title}</h4>
                <p>{r.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ DOORS ============ -->
  <section class="section tight doors-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">One house, several doors</p>
        <h2>Everything Dima, in one place.</h2>
      </div>
      <div class="doors">
        {
          doors.map((d, i) => (
            <a
              class:list={['door', 'reveal', { here: d.here }]}
              style={`--d:${i * 0.06}s`}
              href={d.href}
              target={d.external ? '_blank' : undefined}
              rel={d.external ? 'noopener' : undefined}
            >
              <span class="host">{d.host}</span>
              <span class="label">{d.label}</span>
              <span class="body">{d.body}</span>
              <span class="go">
                {d.here ? 'You are here' : d.external ? 'Open' : 'Visit'}
                {!d.here && <Icon name={d.external ? 'external' : 'arrow'} size={15} />}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DIMA ============ -->
  <section class="section dima-teaser on-paper-2">
    <div class="container split">
      <div class="reading plate reveal">
        <LoopMedia id={media.reading} width={560} label="Line drawing of Dima the dog reading an open book" blend />
      </div>
      <div class="reveal" style="--d:.1s">
        <p class="eyebrow">Why “Dima”?</p>
        <h2>Named for a very good dog.</h2>
        <p class="lede">
          Every book we publish carries Dima’s name, and the standard that comes with it: be curious, be patient, be
          glad to see whoever walks through the door. Good teaching works the same way.
        </p>
        <a class="btn ghost" href="/dima/">Visit Dima’s corner <Icon name="heart" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section tight">
    <div class="container">
      <div class="cta-band on-night reveal">
        <Galaxy center={0.35} />
        <div>
          <p class="eyebrow">For instructors &amp; programs</p>
          <h2>Teaching this course next term?</h2>
          <p>Request a review copy, ask about course adoption, or tell us what your students need. A person reads every message.</p>
        </div>
        <div class="cta-actions">
          <a class="btn gold" href="/contact/?topic=instructor">Request a review copy</a>
          <a class="btn ghost" href="/contact/?topic=adoption">Talk about adoption</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 110px);
  }
  .halo {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 980px;
    max-height: 980px;
    background: radial-gradient(closest-side, rgba(220, 182, 94, 0.28), rgba(220, 182, 94, 0.08) 55%, transparent 72%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero h1 {
    margin-bottom: 0.35em;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .facts li {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .facts strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
  }
  .hero-art {
    position: relative;
  }
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: rgba(255, 253, 248, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    box-shadow: var(--shadow);
    color: var(--ink-2);
    animation: float 7s ease-in-out infinite;
  }
  .chip :global(svg) {
    color: var(--gold);
  }
  .c1 {
    top: -3%;
    left: 2%;
  }
  .c2 {
    top: 46%;
    right: -7%;
    animation-delay: -2.3s;
  }
  .c3 {
    bottom: -4%;
    left: -5%;
    animation-delay: -4.6s;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }
    .c2 {
      right: -2%;
    }
    .c3 {
      left: 0;
    }
  }

  /* ---------- marquee ---------- */
  .marquee {
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding: 18px 0;
    background: var(--card);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    gap: 40px;
    width: max-content;
    animation: scroll 46s linear infinite;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- make ---------- */
  .make .card {
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .make .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .ico {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--gold-wash);
    color: var(--gold-deep);
    margin-bottom: 22px;
  }
  .make p {
    color: var(--ink-soft);
  }

  /* ---------- featured ---------- */
  .featured {
    overflow: hidden;
  }
  .cover-col {
    position: relative;
    padding: 20px 0;
  }
  .glow {
    position: absolute;
    inset: 10% 15%;
    background: radial-gradient(closest-side, rgba(220, 182, 94, 0.45), transparent);
    filter: blur(30px);
  }
  .sub {
    display: grid;
    gap: 6px;
    margin: -0.2em 0 1.6em;
  }
  .sub span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: #f0e6cf;
  }
  .sub .by {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }

  /* ---------- differences ---------- */
  .diffs {
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .diff {
    position: relative;
    padding: clamp(26px, 3vw, 40px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s;
  }
  .diff:hover {
    background: var(--card);
  }
  .diff .num {
    position: absolute;
    top: 22px;
    right: 24px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .diff :global(.diff-ico) {
    color: var(--gold);
    margin-bottom: 18px;
  }
  .diff p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    margin: 0;
  }

  /* ---------- arc ---------- */
  .arc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    position: relative;
  }
  .arc::before {
    content: '';
    position: absolute;
    top: 13px;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold-bright), var(--gold-deep));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.8s var(--ease) 0.2s;
  }
  .arc.in::before {
    transform: scaleX(1);
  }
  .arc li {
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }
  .dot {
    width: 28px;
    height: 28px;
    rotate: 45deg;
    background: var(--paper-2);
    border: 2px solid var(--gold);
    position: relative;
    z-index: 1;
    transition: background 0.4s;
    transition-delay: calc(0.3s + var(--i) * 0.25s);
  }
  .arc.in .dot {
    background: var(--gold);
  }
  .step {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.4rem);
  }
  @media (max-width: 720px) {
    .arc {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-left: 6px;
    }
    .arc::before {
      top: 14px;
      bottom: 14px;
      left: 19px;
      right: auto;
      width: 2px;
      height: auto;
      transform: scaleY(0);
      transform-origin: top;
    }
    .arc.in::before {
      transform: scaleY(1);
    }
    .arc li {
      grid-auto-flow: column;
      justify-content: start;
      text-align: left;
    }
  }

  /* ---------- rhythm ---------- */
  .rhythm-split {
    align-items: start;
  }
  .rhythm {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .rhythm li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .rhythm .n {
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    color: var(--gold);
  }
  .rhythm h4 {
    margin: 2px 0 4px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: 0;
  }
  .rhythm p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ---------- doors ---------- */
  .doors {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 22px;
    min-height: 220px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.3s;
  }
  .door:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
    border-color: var(--gold);
  }
  .door.here {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .host {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold-deep);
    word-break: break-all;
  }
  .here .host {
    color: var(--gold-bright);
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .body {
    font-size: 0.9rem;
    color: var(--muted);
    flex: 1;
  }
  .here .body {
    color: rgba(251, 249, 244, 0.7);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
  }
  @media (max-width: 1080px) {
    .doors {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .door {
      min-height: 0;
    }
  }

  /* ---------- dima ---------- */
  .reading {
    max-width: 400px;
  }

  /* ---------- cta ---------- */
  .cta-band {
    border-radius: var(--radius-l);
    padding: clamp(36px, 6vw, 72px);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    align-items: center;
    box-shadow: var(--shadow-l);
  }
  .cta-band h2 {
    margin-bottom: 0.3em;
  }
  .cta-band p:last-child {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }
  @media (max-width: 820px) {
    .cta-band {
      grid-template-columns: 1fr;
    }
    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
