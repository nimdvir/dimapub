---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const topics = [
  { value: 'general', label: 'General question' },
  { value: 'instructor', label: 'Instructor review copy or resources' },
  { value: 'adoption', label: 'Adopting the book for a course' },
  { value: 'bulk', label: 'Department or campus access' },
  { value: 'support', label: 'Help with the reader' },
  { value: 'authors', label: 'Publishing with us' },
  { value: 'partnerships', label: 'Partnerships & pilots' },
  { value: 'press', label: 'Press & media' },
  { value: 'portal', label: 'Partner portal access' },
];
---

<Base title="Contact" description="Contact Dima Publishing about review copies, course adoption, reader support, partnerships or publishing with us.">
  <PageHero
    eyebrow="Contact"
    title="Let’s <em class='gold'>talk</em>."
    lede="Review copies, course adoption, reader help, partnerships or a book idea. Send a note and a person will get back to you, usually within two business days."
  />

  <section class="section">
    <div class="container contact-grid">
      <form class="card form reveal" data-contact>
        <div class="row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" autocomplete="name" required maxlength="200" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="320" />
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label for="organization">School or organization <span class="opt">(optional)</span></label>
            <input id="organization" name="organization" autocomplete="organization" maxlength="200" />
          </div>
          <div class="field">
            <label for="topic">What is this about?</label>
            <select id="topic" name="topic">
              {topics.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required minlength="5" maxlength="5000" placeholder="Tell us a little about your course, your question or your idea."></textarea>
        </div>
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="submit-row">
          <button class="btn gold" type="submit">Send message <Icon name="arrow" size={18} /></button>
          <p class="note">By sending, you agree to our <a href="/privacy/">privacy policy</a>.</p>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side reveal" style="--d:.08s">
        <div class="side-block">
          <Icon name="mail" size={24} />
          <h3>Email us directly</h3>
          <p>For anything at all.</p>
          <a class="text-link big" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="side-block">
          <Icon name="graduation" size={24} />
          <h3>Instructors</h3>
          <p>Choose “Instructor review copy” and tell us your course and term. We’ll set you up with full access.</p>
        </div>
        <div class="side-block">
          <Icon name="screen" size={24} />
          <h3>Students</h3>
          <p>Trouble with the reader? Choose “Help with the reader” and include your course and the chapter you were on.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 4vw, 44px);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  .submit-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .note a {
    color: var(--gold-deep);
  }
  :global(form.sent) .field textarea {
    border-color: #9bc3a5;
  }
  .side {
    display: grid;
    gap: 14px;
  }
  .side-block {
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .side-block :global(svg) {
    color: var(--gold);
    margin-bottom: 12px;
  }
  .side-block h3 {
    font-size: 1.25rem;
    margin-bottom: 0.3em;
  }
  .side-block p {
    margin: 0 0 0.6em;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .big {
    font-size: 1.1rem;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Preselect the topic from ?topic=… links across the site.
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.querySelector<HTMLSelectElement>('#topic');
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>
