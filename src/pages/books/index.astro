---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BookCover from '../../components/BookCover.astro';
import Icon from '../../components/Icon.astro';
import { book } from '../../data/site';
---

<Base title="Books" description="The Dima Publishing catalog: interactive, classroom-tested books that connect learning to doing.">
  <PageHero
    eyebrow="The catalog"
    title="Books worth <em class='gold'>finishing</em>."
    lede="We publish fewer books, on purpose. Each one is written by someone who teaches the subject, tested with the students who learn it, and built to be used, not just assigned."
  />

  <section class="section">
    <div class="container">
      <article class="feature reveal">
        <div class="cover"><BookCover width={300} eager /></div>
        <div class="info">
          <p class="eyebrow">Available now · Interactive textbook</p>
          <h2><a href={`/books/${book.slug}/`}>{book.title}</a></h2>
          <p class="sub">{book.subtitle}</p>
          <p class="by">by {book.author}</p>
          <p>
            A business-first database course: real SQL from the first weeks, two complete systems that grow across the
            semester, and a final stretch on BI, strategy and AI-ready data. Written for students who will use data
            to make decisions.
          </p>
          <ul class="pills">
            <li>16 chapters</li>
            <li>4 appendices</li>
            <li>Executable SQL</li>
            <li>Labs &amp; reading checks</li>
          </ul>
          <div class="cta">
            <a class="btn" href={`/books/${book.slug}/`}>About the book <Icon name="arrow" size={18} /></a>
            <a class="btn ghost" href={book.readerUrl} target="_blank" rel="noopener">Open the reader <Icon name="external" size={16} /></a>
          </div>
        </div>
      </article>

      <div class="grid cols-2 next">
        <article class="card soon reveal">
          <span class="ico"><Icon name="pen" size={24} /></span>
          <h3>Next titles are in development</h3>
          <p>
            We are building out a small list of applied, classroom-first books across business, analytics and
            technology. Join the list in the footer to hear first.
          </p>
        </article>
        <article class="card soon reveal" style="--d:.08s">
          <span class="ico"><Icon name="book" size={24} /></span>
          <h3>Teach something that deserves a better book?</h3>
          <p>
            We work with instructors who want to write the book their students actually need, and we bring the
            editing, design and interactive platform.
          </p>
          <a class="text-link" href="/contact/?topic=authors">Pitch us your idea →</a>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .feature {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--radius-l);
    background:
      radial-gradient(600px 400px at 0% 50%, rgba(220, 182, 94, 0.18), transparent 70%),
      var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .feature h2 a {
    text-decoration: none;
  }
  .feature h2 a:hover {
    color: var(--gold-deep);
  }
  .sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin-bottom: 0.2em;
  }
  .by {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
  }
  .pills li {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .next {
    margin-top: 28px;
  }
  .soon p {
    color: var(--ink-soft);
  }
  .ico {
    display: inline-grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: var(--gold-wash);
    color: var(--gold-deep);
    margin-bottom: 18px;
  }
  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .cover {
      max-width: 260px;
      margin-inline: auto;
    }
  }
</style>
