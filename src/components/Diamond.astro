---
// The faceted gold diamond from the Dima Publishing seal, drawn as a crisp vector.
interface Props {
  size?: number;
  class?: string;
  tone?: 'gold' | 'light';
}
const { size = 28, class: className = '', tone = 'gold' } = Astro.props;
const id = `dg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${id}-a`} x1="8" y1="10" x2="56" y2="56" gradientUnits="userSpaceOnUse">
      {tone === 'gold' ? (
        <>
          <stop offset="0" stop-color="#f1d58a" />
          <stop offset=".45" stop-color="#c99a3f" />
          <stop offset="1" stop-color="#8a6320" />
        </>
      ) : (
        <>
          <stop offset="0" stop-color="#fff6dc" />
          <stop offset="1" stop-color="#dcb65e" />
        </>
      )}
    </linearGradient>
  </defs>
  <path d="M14 10h36l10 14-28 32L4 24 14 10Z" fill={`url(#${id}-a)`} />
  <path
    d="M4 24h56M14 10l8 14 10-14 10 14 8-14M22 24l10 32 10-32"
    stroke="#fff8e6"
    stroke-opacity=".75"
    stroke-width="1.6"
    stroke-linejoin="round"
  />
  <path d="M14 10h36l10 14-28 32L4 24 14 10Z" stroke="#7a571b" stroke-opacity=".35" stroke-width="1" />
</svg>
