---
// A dimensional book: the cover art with a spine, page edges and a soft shadow.
// Tilts gently toward the pointer on devices that hover.
import { img, srcset, media } from '../lib/media';

interface Props {
  width?: number;
  class?: string;
  eager?: boolean;
}
const { width = 360, class: className = '', eager = false } = Astro.props;
---

<div class:list={['book3d', className]} style={`--w:${width}px`} data-tilt>
  <div class="book">
    <img
      src={img(media.cover, 720)}
      srcset={srcset(media.cover, [360, 540, 720, 1024])}
      sizes={`${width}px`}
      width="1024"
      height="1536"
      alt="Cover of Using Data to Drive Business Performance by Dr. Nimrod Dvir"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="shine" aria-hidden="true"></span>
  </div>
</div>

<style>
  .book3d {
    width: min(var(--w), 100%);
    perspective: 1600px;
    margin-inline: auto;
  }
  .book {
    --rx: 0deg;
    --ry: -16deg;
    position: relative;
    aspect-ratio: 2 / 3;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.9s var(--ease);
    border-radius: 3px 8px 8px 3px;
    box-shadow:
      1px 1px 0 rgba(255, 255, 255, 0.3) inset,
      26px 34px 60px -18px rgba(5, 8, 18, 0.65),
      8px 10px 20px -10px rgba(5, 8, 18, 0.5);
  }
  .book img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px 8px 8px 3px;
  }
  /* spine highlight */
  .book::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 7%;
    border-radius: 3px 0 0 3px;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), rgba(255, 255, 255, 0.25) 45%, rgba(0, 0, 0, 0.12) 75%, transparent);
    z-index: 2;
  }
  /* page block */
  .book::after {
    content: '';
    position: absolute;
    top: 1.2%;
    bottom: 1.2%;
    right: 0;
    width: 28px;
    transform: translateX(100%) rotateY(90deg);
    transform-origin: left center;
    background: repeating-linear-gradient(90deg, #f5f0e4 0 2px, #e2d9c6 2px 3px);
  }
  .shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.28) 46%, transparent 60%);
    background-size: 250% 100%;
    background-position: 100% 0;
    transition: background-position 1.2s var(--ease);
    mix-blend-mode: soft-light;
    pointer-events: none;
    z-index: 3;
  }
  .book3d:hover .shine {
    background-position: 0 0;
  }
</style>

<script>
  const canHover = window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches;
  if (canHover) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((wrap) => {
      const book = wrap.querySelector<HTMLElement>('.book');
      if (!book) return;
      wrap.addEventListener('pointermove', (e) => {
        const r = wrap.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        book.style.setProperty('--ry', `${-8 + x * 18}deg`);
        book.style.setProperty('--rx', `${-y * 10}deg`);
      });
      wrap.addEventListener('pointerleave', () => {
        book.style.setProperty('--ry', '-16deg');
        book.style.setProperty('--rx', '0deg');
      });
    });
  }
</script>
