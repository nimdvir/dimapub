---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  night?: boolean;
  center?: boolean;
}
const { eyebrow, title, lede, night = false, center = false } = Astro.props;
---

<section class:list={['page-hero', 'grain', { 'on-night': night, center }]}>
  <div class="container">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="reveal" style="--d:.06s" set:html={title} />
    {lede && <p class="lede reveal" style="--d:.12s">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: clamp(56px, 9vw, 120px) 0 clamp(48px, 7vw, 88px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .page-hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: -40%;
    width: 60vw;
    height: 60vw;
    max-width: 820px;
    max-height: 820px;
    background: radial-gradient(closest-side, rgba(220, 182, 94, 0.2), transparent 70%);
    pointer-events: none;
  }
  .page-hero.on-night {
    border-bottom: 0;
  }
  h1 {
    max-width: 15ch;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
  }
  .center {
    text-align: center;
  }
  .center h1,
  .center .lede {
    margin-inline: auto;
  }
  .center .eyebrow {
    justify-content: center;
  }
  .container {
    position: relative;
  }
</style>
